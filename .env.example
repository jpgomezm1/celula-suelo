# Copia este archivo como .env.local y llena los valores (pídelos a JP; nunca los subas al repositorio).

# Base de datos de la célula (Neon, proyecto celula-suelo). Lectura y escritura.
DATABASE_URL=

# Lectura de Fynder: rol celula_reader, solo ve las vistas celula_export (sin datos personales).
FYNDER_READ_URL=

# Token del servidor MCP: los clientes lo mandan como "Authorization: Bearer <token>" o ?token=<token>.
MCP_TOKEN=

# Acceso al workspace web (/mapa) con usuario y clave (HTTP Basic).
APP_USER=
APP_PASSWORD=

# Secreto del cron diario de Vercel (/api/cron/fynder).
CRON_SECRET=

# Croma (RUES, folios de matrícula). Opcional: sin ella no hay historia de folios nueva ni ficha de empresa.
CROMA_API_KEY=

# URL pública del despliegue, para los enlaces al Excel que devuelve el MCP (p. ej. https://celula-suelo.vercel.app).
PUBLIC_URL=
